# Артефакты выполнения задач — не версионируются
jobs/

# Отчёты/скриншоты browser- и testing-агентов (одноразовый вывод прогонов)
ai-research/

# Сгенерированные агенты (deploy-agent создаёт .md из agents/*.json)
.opencode/

# Worktree'ы кодовых агентов (agent/<task> ветки, создаются per-task)
.claude/worktrees/

# Резервные копии окружения/реестра (машинозависимые, могут содержать пути)
backups/

# Сырые логи делегированных прогонов
research/*.log

# Тестовые артефакты
test-agent-v3-result.md

# Локальные секреты/ключи — не должны попасть в публичный репозиторий
# (см. docs/ideas.md, «Ключи в .claude/settings.local.json»)
**/.claude/settings.local.json
