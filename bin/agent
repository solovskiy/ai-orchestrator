#!/usr/bin/env bash
# agent — запуск CLI-агентов как отсоединённых фоновых задач.
#
# Всё состояние живёт в этой же папке (.ai), путей наружу нет —
# каталог можно целиком перенести на другую машину.

set -uo pipefail

die() { echo "agent: $*" >&2; exit 1; }

# Приводит путь к виду D:/foo/bar — понятен и Git Bash, и Windows-бинарям.
# -a (absolute) ОБЯЗАТЕЛЕН: без него cygpath/wslpath -m молча возвращает
# относительный путь как есть (не резолвит против pwd) — opencode.exe
# получает такой путь в --dir и падает "Failed to change directory"
# (баг найден и разобран 2026-07-27, job vytrata-palyva-...-6513).
winpath() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -am "$1"; return; fi
  if command -v wslpath >/dev/null 2>&1; then wslpath -am "$1"; return; fi
  echo "$1"
}

AI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="$AI_HOME/lib"
JOBS_DIR="$AI_HOME/jobs"
AGENT_JS="$LIB/agent.js"
AGENT_JS_WIN="$(winpath "$AGENT_JS")"
JOBS_DIR_WIN="$(winpath "$JOBS_DIR")"

# Имена агентов из agents/*.json — для подсказок в ошибках и для help.
# ("${names[*]}" с IFS из двух символов взял бы только первый — джойним руками.)
agent_roster() {
  local f names=()
  for f in "$AI_HOME/agents"/*.json; do
    [[ -f "$f" ]] || continue
    names+=("$(basename "$f" .json)")
  done
  local out="" n
  for n in "${names[@]}"; do
    out="${out:+$out, }$n"
  done
  echo "$out"
}

# Короткая справка (видимый интерфейс) — полная версия в usage_all().
usage() {
  cat <<EOF
agent — делегирование задач фоновым CLI-агентам

  agent delegate <агент> "<задача>" [--verify "<cmd>"]   ОДИН вызов: start+wait+heal+result
                                                          (запускать через Bash run_in_background)
  agent list                                             все задачи
  agent status  <jobId>                                  детали задачи
  agent result  <jobId>                                  только итоговый ответ агента
  agent accept  <jobId>                                  принять worktree-задачу (squash-мердж в текущую ветку)
  agent discard <jobId>                                  отбросить worktree-задачу (удалить ветку/worktree)
  agent agents                                           список агентов (имя/модель/worktree/инструменты)

Примеры:
  agent delegate research "изучи X, сохрани отчёт в X.md"
  agent delegate coding "реализуй Y по образцу Z" --verify "npm test"
  agent list
  agent status rozetka-ui-20260726-140000-42-ab12
  agent accept rozetka-ui-20260726-140000-42-ab12

Текущий ростер агентов: $(agent_roster)
agent help --all — все команды (start/wait/send/heal/tail/kill/clean/worktree-gc/...)
EOF
}

# Полный список — команды из "внутренней кухни" (низкий уровень, обслуживание),
# которые не нужны для повседневного делегирования, но остаются доступны.
usage_all() {
  usage
  cat <<'EOF'

Полный список команд:
  agent start   <агент> "<задача>" [опции]            запустить задачу (фон, без ожидания)
  agent chat    --task <slug> --repo <path> --model <prov/model>  интерактивный чат (foreground)
  agent tail    <jobId> [n]                           последние n блоков вывода (по умолч. 20)
  agent wait    <jobId> [<jobId>...] [--timeout N]    ждать завершения (запускать в фоне — тогда придёт уведомление)
  agent send    <jobId> "<текст>"                     продолжить сессию новой задачей
  agent kill    <jobId>                               остановить задачу
  agent heal    <jobId>                               восстановить проваленную задачу (validation_error/abandoned)
  agent clean   [--days N]                            удалить задачи старше N дней (по умолч. 7)
  agent worktree-gc --repo <path> [--apply] [--older-than N]  отчёт/уборка worktree и веток agent/*
  agent stats [--days N] [--json]                     агрегация стоимости и токенов по всем задачам
  agent init                                          установить agent в PATH (~/bin/agent) и обновить skill
  agent dashboard [--port N] [--open]                 локальный веб-дашборд (localhost:9191)
  agent cron-daily                                    ежедневная очистка (worktree-gc + clean)
  agent agent list                                    список агентов (agents/*.json)
  agent agent show <name>                             показать полный JSON агента
  agent agent create <name>                           создать нового агента из шаблона
  agent agent delete <name>                           удалить агента

Опции start/delegate (позиционно: agent delegate <агент> "<задача>", или флагами):
  --agent <name>          имя агента из agents/*.json (или первый позиционный аргумент)
  --task <slug>           имя задачи (по умолч. — имя агента, участвует в jobId)
  --repo <path>           репозиторий (по умолч. — git-корень текущей директории)
  --prompt-file <path>    ТЗ из файла
  --prompt <text>         ТЗ строкой (или второй позиционный аргумент; иначе — stdin)
  --worktree              создать git worktree под задачу и работать в нём
                          (--agent уже включает это сам, если у агента worktree: true)
  --branch <name>         имя ветки для worktree (по умолч. agent/<slug>-<id>)
  --base <ref>            от чего ответвлять worktree (по умолч. текущий HEAD)
  --verify "<cmd>"        команда проверки после агента, напр. "npm run typecheck && npm test"

Опции delegate дополнительно:
  --timeout <сек>            таймаут ожидания (по умолч. 1800)
  --no-heal                  не чинить провал автоматически (ни по outcome, ни по verify)
  --max-verify-retries <N>   сколько раз продолжать сессию при красном --verify (по умолч. 2)

Недокументированные алиасы (работают, но не нужны в обычной работе):
  --capability <name>     то же самое, что --agent
  --model <prov/model>    переопределить модель агента (провайдер должен совпадать)
  --runner <name>         исполнитель (по умолч. определяется по --model)
  --variant <level>       переопределить уровень усилия агента (minimal..max)
EOF
}

# Запускает agent.js через $NODE, конвертируя Unix-пути в Windows для node.exe.
agent_js() {
  local args=()
  for a in "$@"; do
    if [[ "$a" == /* ]]; then
      args+=("$(winpath "$a")")
    else
      args+=("$a")
    fi
  done
  "$NODE" "$AGENT_JS_WIN" "${args[@]}"
}

require_node() {
  if command -v node >/dev/null 2>&1; then
    NODE=node
  elif command -v node.exe >/dev/null 2>&1; then
    NODE=node.exe
  else
    die "node не найден в PATH"
  fi
}

job_dir_of() {
  local id="$1"
  [[ -n "$id" ]] || die "не указан jobId"
  local d="$JOBS_DIR/$id"
  [[ -d "$d" ]] || die "задача не найдена: $id"
  echo "$d"
}

# Идемпотентно дописывает в info/exclude основного git-репозитория пути,
# которые .ai сам генерирует рядом с рабочим деревом (worktree-директории,
# деплой агентов/плагинов/конфига opencode внутрь worktree) — иначе
# `git status` в целевом репозитории видит их как untracked-мусор.
# git-common-dir резолвится явно: у самого репозитория он относительный
# (".git"), а внутри worktree — абсолютный путь наружу; на всякий случай
# приводим сами, если git всё же вернул относительный.
ensure_git_exclude() {
  local repo="$1" common_dir exclude_file line
  common_dir="$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null)" || return 0
  [[ "$common_dir" = /* ]] || common_dir="$repo/$common_dir"
  exclude_file="$common_dir/info/exclude"
  mkdir -p "$(dirname "$exclude_file")" 2>/dev/null || return 0
  touch "$exclude_file" 2>/dev/null || return 0
  for line in ".claude/worktrees/" ".opencode/agents/" ".opencode/plugins/" ".opencode/opencode.json"; do
    grep -qxF "$line" "$exclude_file" 2>/dev/null || echo "$line" >> "$exclude_file"
  done
}

cmd_start() {
  local task="" repo="" prompt_file="" prompt_text="" model="" model_explicit=0 verify=""
  local runner="opencode" runner_explicit=0 branch="" base="" make_worktree=0
  local max_parallel="" force=0 capability="" variant=""
  local positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)        task="${2:-}"; shift 2 ;;
      --repo)        repo="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --prompt)      prompt_text="${2:-}"; shift 2 ;;
      --capability)  capability="${2:-}"; shift 2 ;;
      --agent)       capability="${2:-}"; shift 2 ;;  # новое имя, capability — обратная совместимость
      --model)       model="${2:-}"; model_explicit=1; shift 2 ;;
      --verify)      verify="${2:-}"; shift 2 ;;
      --runner)      runner="${2:-}"; runner_explicit=1; shift 2 ;;
      --branch)      branch="${2:-}"; shift 2 ;;
      --base)        base="${2:-}"; shift 2 ;;
      --worktree)    make_worktree=1; shift ;;
      --variant)     variant="${2:-}"; shift 2 ;;
      --max-parallel) max_parallel="${2:-}"; shift 2 ;;
      --force)        force=1; shift ;;
      -h|--help)     usage; return 0 ;;
      --*)           die "неизвестная опция: $1" ;;
      *)             positional+=("$1"); shift ;;
    esac
  done

  # Позиционная форма: agent delegate <агент> "<задача>" — первый
  # позиционный аргумент = агент (если --agent/--capability не задан),
  # второй = ТЗ (если ни --prompt, ни --prompt-file не задан).
  if [[ -z "$capability" && ${#positional[@]} -gt 0 ]]; then
    capability="${positional[0]}"
    positional=("${positional[@]:1}")
  fi
  if [[ -z "$prompt_file" && -z "$prompt_text" && ${#positional[@]} -gt 0 ]]; then
    prompt_text="${positional[0]}"
    positional=("${positional[@]:1}")
  fi
  (( ${#positional[@]} == 0 )) || die "лишние аргументы: ${positional[*]}"

  [[ -n "$capability" || $model_explicit -eq 1 ]] \
    || die "укажи агента: agent delegate <агент> \"<задача>\" (агенты: $(agent_roster))"

  # --agent/--capability <name>: читает конфиг агента из дашборда
  # (AI_DASHBOARD_URL), при недоступности — локальный файл
  # agents/<name>.json. Явные --model/--worktree/--variant приоритетнее.
  if [[ -n "$capability" ]]; then
    local cap_model="" cap_worktree="" cap_variant="" cap_runner=""

    # Try dashboard first → local agents/<name>.json (v3)
    local read_output
    if read_output="$(agent_js agent-read "$capability" 2>/dev/null)"; then
      { IFS= read -r cap_model; IFS= read -r cap_worktree; IFS= read -r cap_variant; IFS= read -r cap_runner; } <<< "$read_output"
    else
      die "неизвестный агент: $capability (агенты: $(agent_roster))"
    fi

    # --model вместе с --agent должен быть той же модели (тот же провайдер) —
    # иначе модель тихо расходится с тем, что настроено в agents/<name>.json,
    # и никто этого не заметит до самого запуска. Другой провайдер — почти
    # всегда ошибка (модель домыслена, а не осознанно переопределена).
    if [[ $model_explicit -eq 1 && -n "$cap_model" && "${model%%/*}" != "${cap_model%%/*}" ]]; then
      die "модель задаётся в agents/$capability.json (сейчас $cap_model) — убери --model"
    fi

    [[ -n "$model" ]] || model="$cap_model"
    [[ -n "$variant" ]] || variant="$cap_variant"
    if [[ "$cap_worktree" == "1" && "$make_worktree" == "0" ]]; then
      make_worktree=1
    fi
    # runner из конфига агента — только если не переопределён явным --runner
    if (( ! runner_explicit )) && [[ -n "$cap_runner" ]]; then
      runner="$cap_runner"
      runner_explicit=1
    fi
  fi

  # Дефолтная модель, если ни --model, ни --agent не подставили её (агент
  # без model в JSON — редкий случай) — бесплатная OpenCode Zen.
  model="${model:-opencode/deepseek-v4-flash-free}"

  # --repo по умолчанию — git-корень текущей директории, иначе сам $PWD.
  if [[ -z "$repo" ]]; then
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || repo="$PWD"
  fi
  [[ -d "$repo" ]] || die "репозиторий не найден: $repo"

  task="${task:-${capability:-task}}"
  [[ "$task" =~ ^[A-Za-z0-9._-]+$ ]] || die "--task: допустимы буквы, цифры, . _ -"

  # --- ТЗ: файл > строка > stdin ---
  local prompt=""
  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "файл ТЗ не найден: $prompt_file"
    prompt="$(cat "$prompt_file")"
  elif [[ -n "$prompt_text" ]]; then
    prompt="$prompt_text"
  elif [[ ! -t 0 ]]; then
    prompt="$(cat)"
  fi
  [[ -n "${prompt// /}" ]] || die "пустое ТЗ (--prompt-file / --prompt / stdin)"

  local job_id="${task}-$(date +%Y%m%d-%H%M%S)-$$-$(printf '%04x' $RANDOM)"
  local job_dir="$JOBS_DIR/$job_id"
  if [[ -e "$job_dir" ]]; then
    die "коллизия jobId: $job_dir уже существует, перезапусти"
  fi

  # Проверка лимита ДО аллокации ресурсов — иначе остаются осиротевшие worktree + job_dir
  local running_count max_parallel_limit
  running_count="$(agent_js running-count "$JOBS_DIR")"
  max_parallel_limit="${max_parallel:-${AGENT_MAX_PARALLEL:-3}}"
  if (( force != 1 && running_count >= max_parallel_limit )); then
    die "уже $running_count задач(и) в статусе 'running' (лимит: $max_parallel_limit). Используй --force чтобы запустить, или agent kill для остановки лишних"
  fi

  mkdir -p "$job_dir" || die "не удалось создать $job_dir"
  printf '%s\n' "$prompt" > "$job_dir/prompt.md"

  # --- рабочая директория: worktree или сам репозиторий ---
  local cwd="$repo" base_branch="" base_commit=""
  if (( make_worktree )); then
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
      || die "не git-репозиторий: $repo — агент ${capability:-агент} работает в своей ветке; для чтения/отчёта возьми research-агента или сделай git init"

    base_branch="$(git -C "$repo" branch --show-current 2>/dev/null)"
    base_commit="$(git -C "$repo" rev-parse "${base:-HEAD}" 2>/dev/null)"

    # Короткий id вместо привязки имени ветки/worktree к одному task —
    # повторный delegate с тем же --task больше не коллидирует и не
    # плодит слаги-подстановки задом наперёд.
    local shortid wt attempt=0
    if [[ -z "$branch" ]]; then
      while :; do
        shortid="$(printf '%04x' $RANDOM)"
        branch="agent/${task}-${shortid}"
        wt="$repo/.claude/worktrees/${task}-${shortid}"
        [[ ! -e "$wt" ]] && ! git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null && break
        (( ++attempt >= 5 )) && die "не удалось подобрать свободное имя ветки/worktree для $task"
      done
    else
      wt="$repo/.claude/worktrees/${task}-$(printf '%04x' $RANDOM)"
    fi

    if [[ -n "$base" ]]; then
      git -C "$repo" worktree add "$wt" -b "$branch" "$base" >/dev/null \
        || die "git worktree add не удался"
    else
      git -C "$repo" worktree add "$wt" -b "$branch" >/dev/null \
        || die "git worktree add не удался"
    fi
    cwd="$wt"
    ensure_git_exclude "$repo"
  fi

  # Деплой агента в целевую директорию (opencode найдёт .opencode/agents/<name>.md)
  local agent_name=""
  if [[ -n "$capability" ]]; then
    agent_name="$capability"
    local deployer; deployer="$(winpath "$LIB/deploy-agent.js")"
    if [[ -f "$deployer" ]]; then
      $NODE "$deployer" "$(winpath "$AI_HOME/agents")" "$agent_name" --target "$(winpath "$cwd")" >&2 2>/dev/null || true
    fi
  fi

  # Деплой плагинов в целевую директорию (.opencode/plugins/)
  local plugins_src="$AI_HOME/plugins"
  if [[ -d "$plugins_src" ]]; then
    local plugins_dst="$cwd/.opencode/plugins"
    mkdir -p "$plugins_dst" || true
    # Копируем всё из plugins/ в .opencode/plugins/ (включая index.js и остальное)
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "$plugins_src/" "$plugins_dst/" 2>/dev/null || true
    else
      # Fallback на cp для систем без rsync
      cp -r "$plugins_src"/* "$plugins_dst/" 2>/dev/null || true
    fi
  fi

  # Деплой конфига opencode.json в целевую директорию
  local opencode_config_src="$AI_HOME/.opencode/opencode.json"
  if [[ -f "$opencode_config_src" ]]; then
    mkdir -p "$cwd/.opencode" || true
    cp "$opencode_config_src" "$cwd/.opencode/opencode.json" 2>/dev/null || true
  fi

  # runner передаём, только если явно указан (иначе agent.js авто-определит)
  local runner_pair=""
  if (( runner_explicit )); then
    runner_pair="runner=$runner"
  fi

  agent_js new "$job_dir" \
    "id=$job_id" \
    "task=$task" \
    $runner_pair \
    "repo=$(winpath "$repo")" \
    "cwd=$(winpath "$cwd")" \
    "worktree=$make_worktree" \
    "branch=$branch" \
    "baseBranch=$base_branch" \
    "baseCommit=$base_commit" \
    "model=$model" \
    "variant=$variant" \
    "agent=$agent_name" \
    "verifyCmd=$verify" \
    || die "не удалось создать job.json"

  NODE="$NODE" AGENT_JS_WIN="$AGENT_JS_WIN" nohup bash "$LIB/run-job.sh" "$job_dir" >/dev/null 2>&1 &
  disown 2>/dev/null || true

  echo "$job_id"
  echo "  рабочая директория: $cwd"
  [[ -n "$verify" ]] && echo "  проверка после агента: $verify"
  echo "  следить: agent status $job_id  ·  ждать (в фоне!): agent wait $job_id"
  return 0
}

# Единая точка входа: start + wait + (при необходимости) один heal-ретрай +
# result — одним вызовом. Рассчитан на запуск ЦЕЛИКОМ через
# Bash(..., run_in_background: true): тогда харнесс сам уведомит по
# завершении, а вызывающему (Claude) не нужно помнить о jobId/wait/heal
# по отдельности — только capability/task/repo на входе и текст результата
# на выходе. Принимает те же опции, что и `start` (--model/--verify/
# --worktree/...), плюс свои: --timeout (передаётся в wait) и --no-heal
# (не чинить провал автоматически, просто вернуть его как есть).
cmd_delegate() {
  local timeout=1800 no_heal=0 max_verify_retries="${AGENT_MAX_VERIFY_RETRIES:-2}"
  local start_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:-1800}"; shift 2 ;;
      --no-heal) no_heal=1; shift ;;
      --max-verify-retries) max_verify_retries="${2:-2}"; shift 2 ;;
      *)         start_args+=("$1"); shift ;;
    esac
  done

  local start_out job_id
  start_out="$(cmd_start "${start_args[@]}")" || { echo "$start_out" >&2; return 1; }
  job_id="$(head -n1 <<<"$start_out")"
  echo "$start_out"

  cmd_wait "$job_id" --timeout "$timeout"

  local d
  d="$(job_dir_of "$job_id")"

  # heal сам решает по diagnosis.outcome, нужно ли чинить (no-op иначе) —
  # exitCode==0 не гарантирует реальный успех (см. cmdFinalize в agent.js),
  # поэтому нельзя полагаться на job.status здесь.
  if [[ "$no_heal" == "0" ]]; then
    local heal_out heal_job_id heal_rc=0
    # agent_js heal имеет три исхода: (1) создал дочернюю задачу — код 0,
    # первая строка stdout = её jobId; (2) чинить не нужно (outcome не
    # подходит) — код 0, в stdout информационное сообщение, НЕ jobId;
    # (3) не может починить (нет sessionId / уже healedAt / сессия занята
    # другой задачей) — код 1, сообщение только в stderr, stdout пустой.
    # Раньше пустой heal_job_id из случая (3) давал "$JOBS_DIR/" — каталог
    # jobs/ сам по себе существует, это ложно трактовалось как успех и
    # роняло весь `delegate` через cmd_wait "" → die. Различаем случаи и
    # кодом возврата, и проверкой каталога — код 0 сам по себе не значит
    # "получили jobId".
    heal_out="$(agent_js heal "$d")" || heal_rc=$?
    heal_job_id="$(head -n1 <<<"$heal_out")"
    if [[ "$heal_rc" == "0" && -d "$JOBS_DIR/$heal_job_id" ]]; then
      echo ""
      echo "$heal_out"
      cmd_wait "$heal_job_id" --timeout "$timeout"
      job_id="$heal_job_id"
    else
      echo "$heal_out"
    fi
  fi

  # Провал самого агента (validation_error/abandoned) и провал verify —
  # разные вещи: агент мог отработать штатно и что-то закоммитить, но
  # тесты/линт красные. verify-heal продолжает ТУ ЖЕ сессию с хвостом
  # verify.log, пока agent heal (выше) на verifyStatus не реагирует.
  # Ограничено max_verify_retries, чтобы не уйти в бесконечный цикл, если
  # агент не может починить проверку.
  if [[ "$no_heal" == "0" ]]; then
    while true; do
      d="$(job_dir_of "$job_id")" || break
      local vstatus; vstatus="$(agent_js get "$d" verifyStatus)"
      [[ "$vstatus" == "failed" ]] || break

      local vh_out vh_job_id vh_rc=0
      vh_out="$(agent_js verify-heal "$d" "$max_verify_retries")" || vh_rc=$?
      vh_job_id="$(head -n1 <<<"$vh_out")"
      if [[ "$vh_rc" == "0" && -d "$JOBS_DIR/$vh_job_id" ]]; then
        echo ""
        echo "$vh_out"
        cmd_wait "$vh_job_id" --timeout "$timeout"
        job_id="$vh_job_id"
      else
        echo "$vh_out"
        break
      fi
    done
  fi

  echo ""
  echo "=== результат ($job_id) ==="
  cat "$JOBS_DIR/$job_id/result.md" 2>/dev/null || echo "(результата нет)"

  # Жизненный цикл ветки — после всех heal/verify-heal ретраев, самым
  # последним действием: пустая worktree-задача убирает себя сама, иначе
  # печатает готовую команду accept/discard. Для НЕ-worktree задач
  # (worktree=0 в job.json) это no-op — agent.js сам проверяет флаг.
  d="$(job_dir_of "$job_id" 2>/dev/null)" && {
    echo ""
    agent_js worktree-finish "$d"
  }
}

cmd_chat() {
  local task="" repo="" prompt_text="" model=""
  local runner="opencode" runner_explicit=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)        task="${2:-}"; shift 2 ;;
      --repo)        repo="${2:-}"; shift 2 ;;
      --prompt)      prompt_text="${2:-}"; shift 2 ;;
      --model)       model="${2:-}"; shift 2 ;;
      --runner)      runner="${2:-}"; runner_explicit=1; shift 2 ;;
      -h|--help)     usage; return 0 ;;
      *)             die "неизвестная опция: $1" ;;
    esac
  done

  [[ -n "$task" ]]  || die "--task обязателен"
  [[ -n "$repo" ]]  || die "--repo обязателен"
  [[ -d "$repo" ]]  || die "репозиторий не найден: $repo"
  [[ -n "$model" ]] || die "--model обязателен (напр. deepseek/deepseek-v4-chat)"

  local job_id="${task}-$(date +%Y%m%d-%H%M%S)-$$-$(printf '%04x' $RANDOM)"
  local job_dir="$JOBS_DIR/$job_id"
  if [[ -e "$job_dir" ]]; then
    die "коллизия jobId: $job_dir уже существует, перезапусти"
  fi
  mkdir -p "$job_dir" || die "не удалось создать $job_dir"
  printf '%s\n' "${prompt_text:-Начинаем чат}" > "$job_dir/prompt.md"

  local cwd; cwd="$(winpath "$repo")"

  # runner авто-определение (как в cmd_start)
  local runner_pair=""
  if (( runner_explicit )); then
    runner_pair="runner=$runner"
  fi

  agent_js new "$job_dir" \
    "id=$job_id" "task=$task" $runner_pair \
    "repo=$cwd" "cwd=$cwd" \
    "model=$model" \
    || die "не удалось создать job.json"

  agent_js set "$job_dir" "status=running" "startedAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # определяем runner и запускаем интерактивно
  local runner_name
  runner_name="$(agent_js get "$job_dir" runner)"

  echo "=== Чат: $task ($model через $runner_name) ==="
  echo "  Рабочая директория: $cwd"
  echo "  Для выхода: Ctrl+C или /exit в чате агента"
  echo ""

  case "$runner_name" in
    opencode)
      local interactive_args=("opencode" "run" "--interactive" "--model" "$model" "--dir" "$cwd" "--title" "$task")
      if [[ -n "$prompt_text" ]]; then
        interactive_args+=("$prompt_text")
      fi
      "${interactive_args[@]}"
      local exit_code=$?
      ;;
    claude)
      local claude_model="${model#claude/}"
      claude --model "$claude_model" "$prompt_text"
      local exit_code=$?
      ;;
    gemini)
      local gemini_model="${model#gemini/}"
      gemini interact --model "$gemini_model"
      local exit_code=$?
      ;;
    *)
      die "чат не поддерживается для runner=$runner_name (доступно: opencode, claude, gemini)"
      ;;
  esac

  agent_js set "$job_dir" "finishedAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)" "exitCode=$exit_code"
  if (( exit_code == 0 )); then
    agent_js set "$job_dir" status=completed
    echo ""
    echo "Чат завершён (код $exit_code). Сессия сохранена: $job_id"
  else
    agent_js set "$job_dir" status=failed
    echo ""
    echo "Чат прерван (код $exit_code). Состояние: $job_id"
  fi
  return $exit_code
}

cmd_send() {
  local id="${1:-}"; shift || true
  local msg="${1:-}"
  local src; src="$(job_dir_of "$id")" || exit 1
  [[ -n "$msg" ]] || die "нужен текст сообщения"

  local session; session="$(agent_js get "$src" sessionId)"
  [[ -n "$session" && "$session" != "null" ]] \
    || die "у задачи $id нет sessionId — продолжать нечего"

  # Гонка: два параллельных продолжения одной сессии портят её историю.
  if [[ "$(agent_js session-busy "$JOBS_DIR" "$session")" == "1" ]]; then
    die "сессия $session уже выполняется в другой задаче — параллельное продолжение ОДНОЙ сессии ломает её историю. Дождись завершения (agent list) или останови ту задачу (agent kill)"
  fi

  local task repo cwd runner model verify worktree branch base_branch base_commit
  task="$(agent_js get "$src" task)"
  repo="$(agent_js get "$src" repo)"
  cwd="$(agent_js get "$src" cwd)"
  runner="$(agent_js get "$src" runner)"
  model="$(agent_js get "$src" model)"
  verify="$(agent_js get "$src" verifyCmd)"
  worktree="$(agent_js get "$src" worktree)"
  [[ "$worktree" == "1" || "$worktree" == "true" ]] && worktree=1 || worktree=0
  # Ветка/база — прокидываем дальше, чтобы accept/discard/worktree-finish
  # находили её и через продолжения сессии (send), а не только у корня.
  branch="$(agent_js get "$src" branch)"
  base_branch="$(agent_js get "$src" baseBranch)"
  base_commit="$(agent_js get "$src" baseCommit)"

  # Проверка лимита параллельных задач
  local running_count max_parallel_limit
  running_count="$(agent_js running-count "$JOBS_DIR")"
  max_parallel_limit="${AGENT_MAX_PARALLEL:-3}"
  if (( running_count >= max_parallel_limit )); then
    die "уже $running_count задач(и) в статусе 'running' (лимит: $max_parallel_limit). Дождись завершения или используй agent kill"
  fi

  local job_id="${task}-$(date +%Y%m%d-%H%M%S)-$$-$(printf '%04x' $RANDOM)"
  local job_dir="$JOBS_DIR/$job_id"
  if [[ -e "$job_dir" ]]; then
    die "коллизия jobId: $job_dir уже существует, перезапусти"
  fi
  mkdir -p "$job_dir" || die "не удалось создать $job_dir"
  printf '%s\n' "$msg" > "$job_dir/prompt.md"

  agent_js new "$job_dir" \
    "id=$job_id" "task=$task" "runner=$runner" "repo=$repo" "cwd=$cwd" \
    "worktree=$worktree" "branch=$branch" "baseBranch=$base_branch" "baseCommit=$base_commit" \
    "model=$model" "verifyCmd=$verify" \
    "sessionId=$session" "resume=true" "continuesJob=$id" \
    || die "не удалось создать job.json"

  NODE="$NODE" AGENT_JS_WIN="$AGENT_JS_WIN" nohup bash "$LIB/run-job.sh" "$job_dir" >/dev/null 2>&1 &
  disown 2>/dev/null || true

  echo "$job_id"
  echo "  продолжает сессию $session (из $id)"
  echo "  ждать (в фоне!): agent wait $job_id"
  return 0
}

# Блокирующее ожидание терминального статуса. Смысл — в том, ЧТО его
# запускают: оркестратор (Claude Code) через свой фоновый Bash, и тогда
# харнесс присылает уведомление, когда wait выйдет. Сам agent start этого
# не умеет — задача отсоединена через nohup, харнесс о ней не знает.
cmd_wait() {
  local timeout=1800 interval=8 ids=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)  timeout="${2:-1800}"; shift 2 ;;
      --interval) interval="${2:-8}"; shift 2 ;;
      -h|--help)  echo "agent wait <jobId> [<jobId>...] [--timeout сек] [--interval сек]"; return 0 ;;
      *)          ids+=("$1"); shift ;;
    esac
  done
  (( ${#ids[@]} > 0 )) || die "нужен хотя бы один jobId"

  local dirs=()
  local id d
  for id in "${ids[@]}"; do
    d="$(job_dir_of "$id")" || exit 1
    dirs+=("$d")
  done

  local waited=0
  while :; do
    local pending=0 st
    for d in "${dirs[@]}"; do
      st="$(agent_js get "$d" status)"
      case "$st" in
        completed|failed|killed) ;;
        *) pending=$((pending + 1)) ;;
      esac
    done
    (( pending == 0 )) && break
    if (( waited >= timeout )); then
      echo "wait: таймаут ${timeout}с — ещё выполняются $pending задач(и). Проверь: agent status <id>" >&2
      return 2
    fi
    sleep "$interval"
    waited=$((waited + interval))
  done

  # все терминальны — компактный итог (одна строка на задачу)
  local ex cf
  for id in "${ids[@]}"; do
    d="$(job_dir_of "$id")"
    st="$(agent_js get "$d" status)"
    ex="$(agent_js get "$d" exitCode)"
    cf="$(agent_js get "$d" changedFiles)"
    echo "$id: $st (код ${ex:-—}${cf:+, изменений $cf})"
  done
  return 0
}

cmd_kill() {
  local id="${1:-}"
  local d; d="$(job_dir_of "$id")" || exit 1
  local pid; pid="$(agent_js get "$d" pid)"

  if [[ -z "$pid" || "$pid" == "null" ]]; then
    echo "у задачи нет записанного pid — возможно, она уже завершилась"
  else
    kill "$pid" 2>/dev/null \
      || taskkill //F //T //PID "$pid" >/dev/null 2>&1 \
      || echo "не удалось остановить процесс $pid (возможно, уже мёртв)"
  fi
  agent_js set "$d" status=killed
  echo "$id помечена как killed"
}

cmd_clean() {
  local days=7
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) days="${2:-7}"; shift 2 ;;
      *) die "неизвестная опция: $1" ;;
    esac
  done
  agent_js clean "$JOBS_DIR" "$days"
}

cmd_worktree_gc() {
  local repo="" apply="" older_than=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)        repo="${2:-}"; shift 2 ;;
      --apply)       apply="--apply"; shift ;;
      --older-than)  older_than="${2:-}"; shift 2 ;;
      -h|--help) echo "agent worktree-gc --repo <path> [--apply] [--older-than N]  (без --apply — только отчёт, ничего не удаляет; --older-than N — вместе с --apply удаляет и брошенные несмерджённые ветки agent/* старше N дней)"; return 0 ;;
      *) die "неизвестная опция: $1" ;;
    esac
  done
  [[ -n "$repo" ]] || die "--repo обязателен"
  [[ -d "$repo" ]] || die "репозиторий не найден: $repo"
  agent_js worktree-gc "$(winpath "$repo")" "$apply" "$older_than"
}

cmd_init() {
  local src="$AI_HOME/skills/agent-bridge"
  local dst="${HOME}/.claude/skills/agent-bridge"

  [[ -d "$src" ]] || die "исходный skill не найден: $src (AI_HOME=$AI_HOME)"

  # Всегда перезаписываем — иначе после обновления .ai в ~/.claude/skills
  # остаётся устаревшая инструкция (старые флаги, забытые команды), и
  # ничего не подсказывает, что её нужно переустановить руками.
  mkdir -p "$dst" || die "не удалось создать $dst"
  # {{AI_HOME}} в исходнике — плейсхолдер, подставляем реальный путь этой
  # машины при деплое: сам SKILL.md в репозитории остаётся переносимым
  # (не завязан на то, куда его склонировали), команды внутри деплоенной
  # копии получаются абсолютными и рабочими из любого cwd.
  sed "s#{{AI_HOME}}#$AI_HOME#g" "$src/SKILL.md" > "$dst/SKILL.md" \
    || die "не удалось скопировать SKILL.md"
  echo "skill agent-bridge установлен/обновлён: $dst (пути закреплены за $AI_HOME)"

  echo ""

  # Обёртка ~/bin/agent — чтобы просто `agent ...` работал из любой
  # директории без абсолютного пути. Git Bash на Windows видит ~/bin по
  # умолчанию. Маркер отличает НАШУ обёртку от чужого файла с тем же
  # именем — чужой не трогаем, только предупреждаем.
  local bin_dir="${HOME}/bin" wrapper="${HOME}/bin/agent"
  local marker="# managed-by: ai-orchestrator init — не редактировать руками"
  mkdir -p "$bin_dir" 2>/dev/null || true
  if [[ -e "$wrapper" ]] && ! grep -qF "$marker" "$wrapper" 2>/dev/null; then
    echo "предупреждение: $wrapper уже существует и не похож на обёртку agent — не трогаю, установи вручную или убери файл"
  else
    {
      echo "#!/usr/bin/env bash"
      echo "$marker"
      echo "exec bash \"$AI_HOME/bin/agent\" \"\$@\""
    } > "$wrapper" && chmod +x "$wrapper" \
      && echo "обёртка установлена: $wrapper → $AI_HOME/bin/agent"
  fi

  case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) echo "  ~/bin не в PATH — добавь: echo 'export PATH=\"\$HOME/bin:\$PATH\"' >> ~/.bashrc" ;;
  esac

  echo ""

  # Глобальная установка агентов в ~/.config/opencode/agents/
  local deployer; deployer="$(winpath "$LIB/deploy-agent.js")"
  if [[ -f "$deployer" ]]; then
    local agents_dir; agents_dir="$(winpath "$AI_HOME/agents")"
    local count=0
    for f in "$AI_HOME/agents"/*.json; do
      [[ -f "$f" ]] || continue
      local name; name="$(basename "$f" .json)"
      $NODE "$deployer" "$agents_dir" "$name" --target --global 2>/dev/null && count=$((count + 1))
    done
    echo "агентов установлено глобально: $count (→ ~/.config/opencode/agents/)"
  fi

  echo ""

  # Глобальная установка плагинов в ~/.config/opencode/plugins/
  local plugins_src="$AI_HOME/plugins"
  if [[ -d "$plugins_src" ]]; then
    local home_dir="${HOME}"
    local plugins_dst="$home_dir/.config/opencode/plugins"
    mkdir -p "$plugins_dst" || die "не удалось создать $plugins_dst"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "$plugins_src/" "$plugins_dst/" 2>/dev/null && echo "плагины установлены глобально: → ~/.config/opencode/plugins/"
    else
      cp -r "$plugins_src"/* "$plugins_dst/" 2>/dev/null && echo "плагины установлены глобально: → ~/.config/opencode/plugins/"
    fi
  fi

  echo ""
  echo "Теперь из любой директории на этой машине: agent delegate <агент> \"<задача>\""
  echo "(если 'agent: command not found' — PATH не обновился в текущем шелле, открой новый терминал)"
  echo ""
  echo "Документация: $AI_HOME/README.md"
}

cmd_cron_daily() {
  echo "=== cron-daily $(date +%Y-%m-%d) ==="

  # Собираем репозитории из всех job.json
  local repos=()
  if [[ -d "$JOBS_DIR" ]]; then
    for f in "$JOBS_DIR"/*/job.json; do
      local r; r="$(agent_js get "$(dirname "$f")" "repo")" || continue
      [[ -n "$r" && -d "$r" ]] || continue
      # дедупликация
      local seen=0
      for existing in "${repos[@]}"; do
        [[ "$existing" == "$r" ]] && { seen=1; break; }
      done
      (( seen )) || repos+=("$r")
    done
  fi

  echo "найдено репозиториев: ${#repos[@]}"
  for repo in "${repos[@]}"; do
    echo "  worktree-gc --repo $repo --apply"
    cmd_worktree_gc --repo "$repo" --apply 2>&1
  done

  echo ""
  echo "  clean --days 7"
  cmd_clean --days 7
  echo "=== готово ==="
}

cmd_dashboard() {
  local port="9191" open_flag=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:-9191}"; shift 2 ;;
      --open) open_flag="--open"; shift ;;
      *) die "неизвестная опция: $1" ;;
    esac
  done

  local dashboard_js; dashboard_js="$(winpath "$LIB/dashboard.js")"
  [[ -f "$dashboard_js" ]] || die "dashboard.js не найден: $dashboard_js"

  echo "запуск дашборда на http://localhost:$port ..."
  $NODE "$dashboard_js" --port "$port" $open_flag
}

main() {
  require_node
  mkdir -p "$JOBS_DIR"

  local cmd="${1:-}"; shift || true
  case "$cmd" in
    delegate) cmd_delegate "$@" ;;
    start)   cmd_start "$@" ;;
    chat)    cmd_chat "$@" ;;
    send)    cmd_send "$@" ;;
    kill)    cmd_kill "$@" ;;
    clean)   cmd_clean "$@" ;;
    worktree-gc) cmd_worktree_gc "$@" ;;
    list)    agent_js list "$JOBS_DIR" ;;
    status)  d="$(job_dir_of "${1:-}")" || exit 1; agent_js show "$d" ;;
    tail)    d="$(job_dir_of "${1:-}")" || exit 1; agent_js tail "$d" "${2:-20}" ;;
    wait)    cmd_wait "$@" ;;
    result)  cat "$(job_dir_of "${1:-}")/result.md" 2>/dev/null \
               || echo "(результата ещё нет)" ;;
    accept)  d="$(job_dir_of "${1:-}")" || exit 1; agent_js accept "$d" ;;
    discard) d="$(job_dir_of "${1:-}")" || exit 1; agent_js discard "$d" ;;
    agents)  agent_js agent-list "$(winpath "$AI_HOME/agents")" ;;
    stats)   agent_js stats "$JOBS_DIR" "$*" ;;
    init)    cmd_init ;;
    dashboard) cmd_dashboard "$@" ;;
    cron-daily) cmd_cron_daily ;;
    agent)
      local sub="${1:-}"; shift || true
      case "$sub" in
        list)   agent_js agent-list "$(winpath "$AI_HOME/agents")" ;;
        show)   agent_js agent-show "$(winpath "$AI_HOME/agents")" "${1:-}" ;;
        create) agent_js agent-create "$(winpath "$AI_HOME/agents")" "${1:-}" ;;
        delete) agent_js agent-delete "$(winpath "$AI_HOME/agents")" "${1:-}" ;;
        *) die "agent agent: неизвестная подкоманда: $sub (list, show, create, delete)" ;;
      esac ;;
    heal)    d="$(job_dir_of "${1:-}")" || exit 1; agent_js heal "$d" ;;
    ""|-h|--help|help)
      if [[ "${1:-}" == "--all" ]]; then usage_all; else usage; fi ;;
    *) die "неизвестная команда: $cmd (agent help --all — полный список)" ;;
  esac
}

main "$@"
